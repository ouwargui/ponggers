{
  "name": "@ponggers/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start",
    "prebuild:dev": "expo prebuild --clean",
    "build:ios": "bunx eas-cli build --platform ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check": "bunx --bun @biomejs/biome check --write",
    "format": "bunx --bun @biomejs/biome format --write",
    "lint": "bunx --bun @biomejs/biome lint --write"
  },
  "dependencies": {
    "@ponggers/signaling-protocol": "workspace:*",
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@expo/ui": "~57.0.6",
    "@shopify/react-native-skia": "^2.8.0",
    "expo": "~57.0.6",
    "expo-constants": "~57.0.5",
    "expo-dev-client": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.6",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.2",
    "react-native-webrtc": "^124.0.7",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "^1.3.14",
    "@types/react": "~19.2.17",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    }
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
