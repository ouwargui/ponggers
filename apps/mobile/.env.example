# Local development can use ws:// and the machine running Wrangler.
# Production builds must use wss://.
# Wrangler defaults to port 8787. Use the computer's LAN IP on a physical phone.
EXPO_PUBLIC_SIGNALING_URL=ws://192.168.0.121:8787/ws

# Development-only connectivity test. When true, WebRTC refuses direct
# candidates and proves that TURN relay works end to end.
EXPO_PUBLIC_FORCE_TURN_RELAY=false

# Game Center is globally fail-closed. Enable only the components that already
# exist in App Store Connect.
EXPO_PUBLIC_GAME_CENTER_ENABLED=false
EXPO_PUBLIC_GAME_CENTER_LEADERBOARDS_ENABLED=false
EXPO_PUBLIC_GAME_CENTER_ACHIEVEMENTS_ENABLED=false
