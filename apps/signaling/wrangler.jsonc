{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ponggers-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "TURN_CREDENTIAL_TTL_SECONDS": "3600"
  },
  "secrets": {
    "required": ["TURN_KEY_ID", "TURN_KEY_API_TOKEN"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_LOBBY",
        "class_name": "SignalingLobby"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingLobby"]
    }
  ]
}
